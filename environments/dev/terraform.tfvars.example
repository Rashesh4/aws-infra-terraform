# =============================================================================
# Example Variable Values — Copy to terraform.tfvars and customize
# =============================================================================

aws_region           = "us-east-1"
environment          = "dev"
project_name         = "web-platform"

vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24"]
private_subnet_cidrs = ["10.0.10.0/24"]
availability_zones   = ["us-east-1a"]

instance_type        = "t2.micro"
ssh_public_key_path  = "~/.ssh/aws-infra-key.pub"

app_bucket_prefix    = "rashesh-web-platform"
allowed_ssh_cidrs    = ["0.0.0.0/0"] # Restrict to your IP in production
